#!/bin/sh
# as2: the one-word launcher for agent-system 2.0 (Jo, 2026-09-29: "i am never going to remember a
# command that long").
#
# Usage:   as2 [omp args...]   start the orchestrator, in <repo> (its cwd is fixed, not the shell's:
#                              Jo's second session ran from ~/tmp, 2026-09-30):
#                              env [-u BASH_ENV ...] [-u OTEL_…]... OTEL_…=… OMP_PROFILE=<profile> AGENT_SYSTEM_ROLE=orchestrator
#                                omp --cwd <repo> --append-system-prompt <prompt> [args...]
#                              <prompt> is $HOME/.agent-system-2/orchestrator/system.md, rendered first
#                              from the voice document and the output-types contract, so every turn
#                              sends the same system prompt (surface/scripts/orchestrator-prompt.ts);
#                              a missing source file stops the launch, naming it. Where gates.cleanShell
#                              is "all" (the clean shell is on for the orchestrator), the shell-start
#                              hooks are dropped (gates/src/shell-start.ts):
#                                env -u BASH_ENV -u ENV -u SHELLOPTS -u BASHOPTS -u POSIXLY_CORRECT -u CDPATH -u PS4 ...
#                              The OTEL_* words are the tracing switch's, below: every inherited OTEL_* name
#                              unset, then OTEL_SDK_DISABLED=true, or the otel map when observability.phoenix is `all`.
#                              Before <prompt> is rendered, the plugin-registry check runs (as2 plugins, below);
#                              a disagreement stops the launch with its status and nothing starts
#          as2 install         run <repo>/install/install.sh (ledger, profile, this launcher); its
#                              last line names the providers to log in to once per profile
#                              (/login inside the session; OMP's first-launch wizard is skipped)
#          as2 on | off        set gates.fence.enabled to true | false in the installed profile's
#                              config.yml, printing the old and new value (a re-install resets it
#                              to the template's value)
#          as2 phoenix off|all|<wl-id>
#                              set observability.phoenix in the installed profile's config.yml (the
#                              tracing switch, wl-mv65t5d34lts00 PLAN.md §§ 2, 8): off, all (the default:
#                              lanes, the orchestrator and every OMP seat), or add a workload's lanes; printing
#                              the old and new value. Read at launch: a lane takes it when (re)launched. A
#                              re-install keeps the installed value
#          as2 clean-shell off | all | <wl>
#                              set gates.cleanShell in the installed profile's config.yml: the clean
#                              shell (gates/src/clean-shell.ts) off everywhere, on everywhere, or on
#                              for workload <wl> too (added to the list; under all it stays all),
#                              printing the old and new value. Running sessions follow it on their
#                              next bash call; a re-install resets it to "off". An edit bun's YAML
#                              does not read back as exactly that change is refused, file unchanged
#          as2 pair-suggest off | all | <wl-id>
#                              set pairSuggest in the installed profile's config.yml (PLAN
#                              wl-mv67564rdkfvnk D2): off, all, or add one workload id to the list;
#                              prints the old and new value, never starts omp
#          as2 rank [--top N]  Jev's ranking of the open workloads, read-only (PLAN wl-mv8k039gvogt8g D5):
#                              bun surface/scripts/rank.ts; the as2_rank table without asking Jev (an
#                              item with no current signal is listed unscored); writes nothing
#          as2 rank-mode show | order | parallel [--budget <usd>]
#                              set jevRank in the installed profile's config.yml (D7): show (launch
#                              order unchanged), order, or parallel; prints the old and new value,
#                              never starts omp: bun surface/scripts/rank-mode.ts
#          as2 plugins         the plugin-registry check alone (PLAN wl-mv8k0fby51uakg D7, jo-issues#51):
#                              env OMP_PROFILE=<profile> bun surface/scripts/plugin-registries.ts check --cwd <repo>;
#                              exit 1 when an OMP registry (the default profile's, <profile>'s, or <repo>'s project
#                              one) gives a plugin a version other than an active Claude Code entry's, printing each
#                              plugin, both versions and paths, and the fix commands; exit 2 on a malformed registry.
#                              Lane launches do not run it
#          as2 lane <wl>       run workload <wl> by hand as a lane in this terminal (user-driven mode;
#                              DESIGN-lane-launcher.md decision 14): bun surface/scripts/lane.ts interactive <wl>
#          as2 lane stop|cleanup|log <wl>
#                              stop the workload's lane (requested through the ledger; signals omp only
#                              when its pid still matches), remove a clean pushed worktree, tail the runner log
#          as2 --print [args]  run the plugin-registry check, render <prompt>, then print the omp command line
#                              `as2 [args]` would run, without running it
#          as2 -h | --help     this text
# Env:     AGENT_SYSTEM_PROFILE  OMP profile name (default: agent-system-2), as install/install.sh
# Exit:    omp's (or install.sh's) own status when launching · 0 ok · 1 failure (a plugin-registry disagreement
#          included) · 2 a malformed plugin registry
#
# <repo> is this script's real directory's parent (bin/..), resolved through any symbolic link,
# so the link install.sh places at $HOME/.local/bin/as2 finds the checkout it points into.
# POSIX sh; runs the same under bash and zsh.
set -eu

PROFILE_NAME="${AGENT_SYSTEM_PROFILE:-agent-system-2}"

# Resolve $0 through symbolic links, one hop at a time (readlink without -f: POSIX-portable).
self="$0"
while [ -L "$self" ]; do
	target="$(readlink "$self")"
	case "$target" in
		/*) self="$target" ;;
		*) self="$(dirname "$self")/$target" ;;
	esac
done
REPO="$(cd -P "$(dirname "$self")/.." && pwd -P)"
AGENT_DIR="$HOME/.omp/profiles/$PROFILE_NAME/agent"
CONFIG="$AGENT_DIR/config.yml"
PROMPT="$HOME/.agent-system-2/orchestrator/system.md"

# Render <prompt>, or stop: omp reads a missing --append-system-prompt path as literal prompt text,
# so a launch never passes one (the script names the missing source on stderr).
render_prompt() {
	bun "$REPO/surface/scripts/orchestrator-prompt.ts" "$PROMPT" || exit 1
}

# The plugin-registry check (surface/scripts/plugin-registries.ts; PLAN wl-mv8k0fby51uakg D7), for the orchestrator's
# profile and <repo>, the cwd omp starts in: any status but 0 stops the caller with that status, the reasons on stderr.
check_plugins() {
	env OMP_PROFILE="$PROFILE_NAME" bun "$REPO/surface/scripts/plugin-registries.ts" check --cwd "$REPO" || exit "$?"
}

usage() {
	sed -n '2,/^set -eu$/{/^set -eu$/d;s/^# \{0,1\}//;p;}' "$REPO/bin/as2"
}

# One argument, quoted for a POSIX shell only when it needs quoting.
quote() {
	case "$1" in
		'' | *[!A-Za-z0-9_./:=@%+,-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
		*) printf '%s' "$1" ;;
	esac
}

# The orchestrator's tracing env (wl-mv65t5d34lts00 PLAN.md § 2; surface/src/tracing.ts), as env(1) words on one
# line: `-u NAME` for every inherited OTEL_* name, then the reader's NAME=value lines
# (surface/scripts/tracing.ts env orchestrator). The reader's notes (a malformed setting) are relayed to stderr.
# If the reader fails or prints anything else, the words are the off state the reader itself gives,
# OTEL_SDK_DISABLED=true (so no dotenv file can turn export on), and one line on stderr says so. Every word is
# in quote()'s unquoted set (names OTEL_[A-Za-z0-9_]*, values the reader's value shape), so callers `eval` it.
tracing_words() {
	words="$(awk 'BEGIN { for (k in ENVIRON) if (k ~ /^OTEL_[A-Za-z0-9_]*$/) printf "-u %s ", k }')"
	if out="$(bun "$REPO/surface/scripts/tracing.ts" env orchestrator --config "$CONFIG" 2>&1)"; then rc=0; else rc=$?; fi
	shape='^OTEL_[A-Z0-9_]+=[A-Za-z0-9_./:=,@%+-]*$'
	other="$(printf '%s\n' "$out" | grep -Ev "$shape|^as2: tracing: " || true)"
	if [ "$rc" -eq 0 ] && [ -z "$other" ] && printf '%s\n' "$out" | grep -q '^OTEL_SDK_DISABLED='; then
		printf '%s\n' "$out" | grep '^as2: tracing: ' >&2 || true
		printf '%s%s\n' "$words" "$(printf '%s\n' "$out" | grep -E "$shape" | tr '\n' ' ')"
	else
		reason="exit $rc"
		[ "$rc" -ne 0 ] || reason="unexpected output"
		printf 'as2: the tracing switch could not be read (%s); omp starts with tracing off (OTEL_SDK_DISABLED=true)\n' "$reason" >&2
		printf '%sOTEL_SDK_DISABLED=true\n' "$words"
	fi
}

fence() {
	want="$1"
	[ -f "$CONFIG" ] || { printf 'as2: no installed profile config at %s; run: as2 install\n' "$CONFIG" >&2; exit 1; }
	# The one key: `enabled:` under `fence:` under the top-level `gates:` mapping (profile/config.yml).
	old="$(awk '
		/^[^ #]/ { gates = ($0 ~ /^gates:[ \t]*$/); fence = 0; next }
		gates && /^  [^ #]/ { fence = ($0 ~ /^  fence:[ \t]*$/); next }
		gates && fence && /^    enabled:/ { v = $0; sub(/^    enabled:[ \t]*/, "", v); sub(/[ \t]*(#.*)?$/, "", v); print v; exit }
	' "$CONFIG")"
	[ -n "$old" ] || { printf 'as2: %s has no gates.fence.enabled key; run: as2 install\n' "$CONFIG" >&2; exit 1; }
	tmp="$CONFIG.tmp.$$"
	awk -v want="$want" '
		/^[^ #]/ { gates = ($0 ~ /^gates:[ \t]*$/); fence = 0; print; next }
		gates && /^  [^ #]/ { fence = ($0 ~ /^  fence:[ \t]*$/); print; next }
		gates && fence && !done && /^    enabled:/ { print "    enabled: " want; done = 1; next }
		{ print }
	' "$CONFIG" >"$tmp" || { rm -f "$tmp"; exit 1; }
	mv -f "$tmp" "$CONFIG"
	printf 'gates.fence.enabled: %s -> %s (%s)\n' "$old" "$want" "$CONFIG"
}

# Whether the clean shell is on for the orchestrator: gates.cleanShell "all", read as the gates read it
# (gates/scripts/clean-shell.ts). Off, unreadable, malformed, or no bun to read it: off, and the
# launch is exactly main's.
orchestrator_clean() {
	bun "$REPO/gates/scripts/clean-shell.ts" orchestrator "$AGENT_DIR" >/dev/null 2>&1
}

# The env(1) words before OMP_PROFILE= on the orchestrator's launch line, for callers to `eval`: the
# clean shell's -u words where orchestrator_clean says on, then tracing_words. Every word is in quote()'s
# unquoted set.
orchestrator_words() {
	if orchestrator_clean; then printf '%s' "-u BASH_ENV -u ENV -u SHELLOPTS -u BASHOPTS -u POSIXLY_CORRECT -u CDPATH -u PS4 "; fi
	tracing_words
}

# The clean-shell switch: `cleanShell:` under the top-level `gates:` mapping (profile/config.yml), read
# by the gates at every bash call (gates/src/clean-shell.ts). Written as `"off"`, `"all"` or a block
# list of workload ids; read also as a bare or single-quoted scalar or a flow list `[a, b]`. The
# `gates:` line may carry a trailing comment. The edit is a text edit into a temp file, renamed into
# place only when bun's YAML reads it back with gates.cleanShell the intended value and every other
# setting as before (gates/scripts/clean-shell.ts verify); else it is refused and config.yml is
# left byte-identical (a flow-mapping `gates:`, say, which the line matcher does not edit).
clean_shell() {
	want="$1"
	case "$want" in
		off | all) ;;
		wl-*)
			rest="${want#wl-}"
			case "$rest" in '' | *[!a-z0-9]*) printf 'as2 clean-shell: %s is not a workload id (wl- then lowercase letters and digits)\n' "$want" >&2; exit 1 ;; esac
			;;
		*) printf 'as2 clean-shell: off, all or a workload id (wl-...), not "%s"\n' "$want" >&2; exit 1 ;;
	esac
	[ -f "$CONFIG" ] || { printf 'as2: no installed profile config at %s; run: as2 install\n' "$CONFIG" >&2; exit 1; }
	# The value as written: `scalar <v>` for a scalar, one `item <v>` per block-list entry, nothing when absent.
	found="$(awk '
		/^[^ #]/ { gates = ($0 ~ /^gates:([ \t]+#.*)?[ \t]*$/); list = 0; next }
		gates && list && /^[ \t]+-/ { v = $0; sub(/^[ \t]+-[ \t]*/, "", v); sub(/[ \t]+#.*$/, "", v); sub(/[ \t]*$/, "", v); print "item " v; next }
		gates && /^  [^ #]/ { list = 0 }
		gates && /^  cleanShell:/ { v = $0; sub(/^  cleanShell:[ \t]*/, "", v); sub(/[ \t]+#.*$/, "", v); sub(/[ \t]*$/, "", v); if (v == "") list = 1; else print "scalar " v }
	' "$CONFIG")"
	scalar="$(printf '%s\n' "$found" | sed -n 's/^scalar //p' | tr -d "\"'")"
	items="$(printf '%s\n' "$found" | sed -n 's/^item //p' | tr -d "\"'")"
	case "$scalar" in \[*) items="$(printf '%s' "$scalar" | tr -d '[] ' | tr ',' '\n' | sed '/^$/d')"; scalar="" ;; esac
	if [ -n "$scalar" ]; then old="$scalar"
	elif [ -n "$items" ]; then old="[$(printf '%s\n' "$items" | paste -sd, - | sed 's/,/, /g')]"
	elif [ -n "$found" ]; then old="[]"
	else old="absent"
	fi
	case "$want" in
		off | all) new="$want"; block="  cleanShell: \"$want\""; json="\"$want\"" ;;
		*)
			if [ "$scalar" = all ]; then
				new=all; block='  cleanShell: "all"'; json='"all"'
			else
				printf '%s\n' "$items" | grep -qx -- "$want" || items="$(printf '%s\n%s\n' "$items" "$want" | sed '/^$/d')"
				new="[$(printf '%s\n' "$items" | paste -sd, - | sed 's/,/, /g')]"
				block="  cleanShell:$(printf '%s\n' "$items" | sed 's/^/\\n    - /' | tr -d '\n')"
				json="[$(printf '%s\n' "$items" | sed 's/.*/"&"/' | paste -sd, -)]"
			fi
			;;
	esac
	if [ -n "$found" ]; then mode=replace
	elif grep -Eq '^gates:([[:space:]]+#.*)?[[:space:]]*$' "$CONFIG"; then mode=insert
	else mode=append
	fi
	tmp="$CONFIG.tmp.$$"
	awk -v block="$block" -v mode="$mode" '
		mode == "insert" && !done && /^gates:([ \t]+#.*)?[ \t]*$/ { print; print block; done = 1; next }
		/^[^ #]/ { gates = ($0 ~ /^gates:([ \t]+#.*)?[ \t]*$/); skip = 0 }
		skip { if ($0 ~ /^[ \t]+-/ || $0 ~ /^    [^ ]/) next; skip = 0 }
		mode == "replace" && gates && !done && /^  cleanShell:/ { print block; done = 1; skip = 1; next }
		{ print }
		END { if (mode == "append") { print "gates:"; print block } }
	' "$CONFIG" >"$tmp" || { rm -f "$tmp"; exit 1; }
	if ! why="$(bun "$REPO/gates/scripts/clean-shell.ts" verify "$CONFIG" "$tmp" "$json" 2>&1)"; then
		rm -f "$tmp"
		printf 'as2 clean-shell: refused, %s is unchanged: %s; set gates.cleanShell by hand (a block mapping under a `gates:` line is what this command edits)\n' "$CONFIG" "${why:-bun could not check the edit}" >&2
		exit 1
	fi
	mv -f "$tmp" "$CONFIG"
	printf 'gates.cleanShell: %s -> %s (%s)\n' "$old" "$new" "$CONFIG"
}

# The pair-suggest switch (PLAN wl-mv67564rdkfvnk D2; surface/src/pair-suggest.ts pairSuggestOn reads it): the
# top-level `pairSuggest:` key is `off`, `all`, or a flow list of workload ids. `off` and `all` replace the value; a
# workload id is added to the list once, and leaves `all` in force untouched (all already covers it). Anything else, or
# no installed config, exits 1 and writes nothing.
pair_suggest() {
	want="${1-}"
	case "$want" in
		off | all) ;;
		wl- | wl-*[!abcdefghijklmnopqrstuvwxyz0123456789]*) want="" ;;
		wl-*) ;;
		*) want="" ;;
	esac
	[ -n "$want" ] || { printf 'as2 pair-suggest: one of off, all or a workload id (wl-…) is required; got %s\n' "${1-nothing}" >&2; exit 1; }
	[ -f "$CONFIG" ] || { printf 'as2: no installed profile config at %s; run: as2 install\n' "$CONFIG" >&2; exit 1; }
	# The value in force: a scalar, a flow list, or a block list read back as a flow list; empty when the key is absent.
	old="$(awk '
		found && /^[ \t]+- / { v = $0; sub(/^[ \t]+- [ \t]*/, "", v); sub(/[ \t]*(#.*)?$/, "", v); items = items (items == "" ? "" : ", ") v; next }
		found { exit }
		/^pairSuggest:/ { v = $0; sub(/^pairSuggest:[ \t]*/, "", v); sub(/[ \t]*(#.*)?$/, "", v); if (v != "") { print v; printed = 1; exit } found = 1; next }
		END { if (found && !printed) print "[" items "]" }
	' "$CONFIG")"
	new="$want"
	case "$old:$want" in
		all:wl-*)
			printf 'pairSuggest: all -> all (%s)\n' "$CONFIG"
			printf 'all already covers %s; the value is unchanged\n' "$want"
			return 0
			;;
	esac
	case "$want" in
		wl-*)
			items=""
			case "$old" in
				\[*\]) items="$(printf '%s' "$old" | sed 's/^\[//; s/\]$//' | tr ',' '\n' | sed "s/^[[:space:]\"']*//; s/[[:space:]\"']*\$//")" ;;
			esac
			new=""
			present=""
			set -f
			for item in $items; do
				[ "$item" = "$want" ] && present=1
				new="${new:+$new, }$item"
			done
			set +f
			[ -n "$present" ] || new="${new:+$new, }$want"
			new="[$new]"
			;;
	esac
	tmp="$CONFIG.tmp.$$"
	awk -v new="$new" '
		skip && /^[ \t]+- / { next }
		{ skip = 0 }
		!done && /^pairSuggest:/ { print "pairSuggest: " new; done = 1; skip = 1; next }
		{ print }
		END { if (!done) print "pairSuggest: " new }
	' "$CONFIG" >"$tmp" || { rm -f "$tmp"; exit 1; }
	mv -f "$tmp" "$CONFIG"
	printf 'pairSuggest: %s -> %s (%s)\n' "${old:-(unset)}" "$new" "$CONFIG"
}

case "${1-}" in
	-h | --help) usage ;;
	install)
		shift
		exec bash "$REPO/install/install.sh" "$@"
		;;
	on) fence true ;;
	clean-shell)
		[ "$#" -eq 2 ] || { printf 'as2 clean-shell: one argument: off, all or a workload id (wl-...)\n' >&2; exit 1; }
		clean_shell "$2"
		;;
	lane)
		shift
		case "${1-}" in
			stop | cleanup | log)
				sub="$1"
				shift
				[ -n "${1-}" ] || { printf 'as2 lane %s: a workload id is required\n' "$sub" >&2; exit 1; }
				exec env OMP_PROFILE="$PROFILE_NAME" bun "$REPO/surface/scripts/lane.ts" "$sub" "$1"
				;;
			'') printf 'as2 lane: a workload id is required (as2 lane <wl> | as2 lane stop|cleanup|log <wl>)\n' >&2; exit 1 ;;
			*) exec env OMP_PROFILE="$PROFILE_NAME" bun "$REPO/surface/scripts/lane.ts" interactive "$1" ;;
		esac
		;;
	off) fence false ;;
	phoenix)
		shift
		[ "$#" -eq 1 ] || { printf 'as2 phoenix: one value is required: off | all | <wl-id>\n' >&2; exit 1; }
		exec bun "$REPO/surface/scripts/tracing.ts" set "$1" --config "$CONFIG"
		;;
	pair-suggest)
		shift
		pair_suggest "$@"
		;;
	rank)
		shift
		exec env OMP_PROFILE="$PROFILE_NAME" bun "$REPO/surface/scripts/rank.ts" "$@"
		;;
	rank-mode)
		shift
		exec env OMP_PROFILE="$PROFILE_NAME" bun "$REPO/surface/scripts/rank-mode.ts" "$@"
		;;
	plugins)
		shift
		[ "$#" -eq 0 ] || { printf 'as2 plugins: takes no arguments\n' >&2; exit 1; }
		check_plugins
		;;
	--print)
		shift
		check_plugins
		render_prompt
		words="$(orchestrator_words)"
		eval "set -- $words OMP_PROFILE=\"\$PROFILE_NAME\" AGENT_SYSTEM_ROLE=orchestrator omp --cwd \"\$REPO\" --append-system-prompt \"\$PROMPT\" \"\$@\""
		line="env"
		for arg in "$@"; do line="$line $(quote "$arg")"; done
		printf '%s\n' "$line"
		;;
	*)
		check_plugins
		render_prompt
		words="$(orchestrator_words)"
		eval "set -- $words OMP_PROFILE=\"\$PROFILE_NAME\" AGENT_SYSTEM_ROLE=orchestrator omp --cwd \"\$REPO\" --append-system-prompt \"\$PROMPT\" \"\$@\""
		exec env "$@"
		;;
esac

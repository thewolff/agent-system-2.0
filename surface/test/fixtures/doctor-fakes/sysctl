#!/bin/sh
# as2 doctor test fake (surface/test/fixtures/doctor-fakes): logs its argv to $AS2_FAKE_STATE/calls.log and answers
# from files under $AS2_FAKE_STATE, which surface/test/fixtures/doctor-fakes/state.ts writes. Never runs the real tool.
S=${AS2_FAKE_STATE:?AS2_FAKE_STATE is not set}
printf '%s\n' "$(basename "$0") $*" >> "$S/calls.log"
# sysctl -n kern.boottime: sysctl.boot holds the boot time in seconds; when absent, the first call fixes it at
# sysctl.uptime seconds (default 3600) before now and writes it, so every later call in the machine answers the same boot.
if [ ! -f "$S/sysctl.boot" ]; then
  up=$(cat "$S/sysctl.uptime" 2>/dev/null || echo 3600)
  echo $(( $(date +%s) - up )) > "$S/sysctl.boot"
fi
echo "{ sec = $(cat "$S/sysctl.boot"), usec = 0 } Mon Nov  2 09:00:00 2026"
